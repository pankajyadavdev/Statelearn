async function competenciesOf(db, userId) {
  const rows = await db.prepare(`SELECT c.id,c.name,c.description,cat.name category,
      COALESCE(uc.self_level,0) selfLevel, COALESCE(uc.current_level,0) currentLevel,
      COALESCE(uc.confidence,0) confidence, jrc.required_level requiredLevel,jrc.priority,
      COALESCE(jrc.required_level,0)-COALESCE(uc.current_level,0) gap
    FROM competencies c JOIN competency_categories cat ON cat.id=c.category_id
    LEFT JOIN user_competencies uc ON uc.competency_id=c.id AND uc.user_id=?
    LEFT JOIN users u ON u.id=? LEFT JOIN job_role_competencies jrc ON jrc.competency_id=c.id AND jrc.job_role_id=u.job_role_id
    WHERE c.active=1 ORDER BY cat.id,c.name`).all(userId, userId);
  return rows.map(row => ({
      ...row,
      gap: Math.max(0, row.gap),
      priority: row.gap <= 0 ? 'No gap' : row.priority,
    }));
}

async function saveGaps(db, userId) {
  const now = new Date().toISOString();
  const user = await db.prepare('SELECT job_role_id FROM users WHERE id=?').get(userId);
  if (!user?.job_role_id) return;
  const competencies = await db.prepare(`SELECT c.id, COALESCE(uc.current_level,0) current_level,j.required_level,j.priority
    FROM job_role_competencies j JOIN competencies c ON c.id=j.competency_id
    LEFT JOIN user_competencies uc ON uc.user_id=? AND uc.competency_id=c.id WHERE j.job_role_id=?`).all(userId, user.job_role_id);
  const upsert = db.prepare(`INSERT INTO skill_gaps(user_id,competency_id,current_level,required_level,gap,priority,updated_at)
    VALUES (?,?,?,?,?,?,?) ON CONFLICT(user_id,competency_id) DO UPDATE SET current_level=excluded.current_level,
    required_level=excluded.required_level,gap=excluded.gap,priority=excluded.priority,updated_at=excluded.updated_at`);
  const remove = db.prepare('DELETE FROM skill_gaps WHERE user_id=?');
  await remove.run(userId);
  for (const row of competencies) {
    const gap = Math.max(0, row.required_level - row.current_level);
    if (gap > 0) await upsert.run(userId, row.id, row.current_level, row.required_level, gap, gap >= 4 ? 'Critical' : gap === 3 ? 'High' : gap === 2 ? 'Medium' : 'Low', now);
  }
}

function classifyGap(gap) {
  if (gap <= 0) return 'No gap';
  if (gap === 1) return 'Low';
  if (gap === 2) return 'Medium';
  if (gap === 3) return 'High';
  return 'Critical';
}

async function recommendationList(db, userId) {
  const comps = await competenciesOf(db, userId);
  const gapById = new Map(comps.map(c => [c.id, c]));
  const courseRows = await db.prepare(`SELECT c.*, cc.competency_id,cc.target_level,co.name competency_name,
      coalesce(p.status,'') progress_status,coalesce(p.progress_percent,0) progress_percent
    FROM courses c JOIN course_competencies cc ON cc.course_id=c.id JOIN competencies co ON co.id=cc.competency_id
    LEFT JOIN user_course_progress p ON p.course_id=c.id AND p.user_id=? WHERE c.active=1 ORDER BY c.id`).all(userId);
  const grouped = new Map();
  const prerequisites = await db.prepare('SELECT course_id,prerequisite_course_id FROM course_prerequisites').all();
  const unmetByCourse = new Map();
  for (const pr of prerequisites) {
    const state = await db.prepare('SELECT status FROM user_course_progress WHERE user_id=? AND course_id=?').get(userId, pr.prerequisite_course_id);
    if (state?.status !== 'completed') unmetByCourse.set(pr.course_id, [...(unmetByCourse.get(pr.course_id) ?? []), pr.prerequisite_course_id]);
  }
  const profile = await profileOf(db, userId);
  const goals = (profile?.careerGoals ?? '').toLowerCase();
  for (const row of courseRows) {
    if (!grouped.has(row.id)) grouped.set(row.id, { id: row.id, title: row.title, summary: row.description, provider: row.provider, providerType: row.provider_type, hours: row.duration_hours, difficulty: row.difficulty, language: row.language, isSynthetic: Boolean(row.is_synthetic), progressStatus: row.progress_status, progressPercent: row.progress_percent, competencies: [], _gaps: [], _score: 0, _reasons: [] });
    const course = grouped.get(row.id);
    const comp = gapById.get(row.competency_id);
    course.competencies.push({ id: row.competency_id, name: row.competency_name, targetLevel: row.target_level, currentLevel: comp?.currentLevel ?? 0, requiredLevel: comp?.requiredLevel ?? 0, gap: comp?.gap ?? 0 });
    if ((comp?.gap ?? 0) > 0) {
      const gapScore = Math.min(1, comp.gap / 4) * 0.30;
      const roleScore = ((comp.requiredLevel ?? 0) / 5) * 0.25;
      const semanticScore = (goals && goals.includes(row.competency_name.toLowerCase()) ? 1 : 0.55) * 0.20;
      const historyScore = row.progress_status === 'completed' ? 0 : row.progress_status === 'in_progress' ? 0.3 : 1;
      const difficultyScore = row.difficulty === 'Beginner' ? 0.95 : 0.68;
      const prerequisiteScore = unmetByCourse.has(row.id) ? 0.4 : 1;
      const priorityScore = comp.priority === 'Critical' ? 1 : comp.priority === 'High' ? 0.85 : comp.priority === 'Medium' ? 0.65 : 0.45;
      course._score += gapScore + roleScore + semanticScore + historyScore * 0.10 + difficultyScore * 0.05 + prerequisiteScore * 0.05 + priorityScore * 0.05;
      course._gaps.push(comp.name);
    }
  }
  const selected = [...grouped.values()].filter(c => c._gaps.length && c.progressStatus !== 'completed').map(c => {
    const relevant = [...new Set(c._gaps)];
    c.score = Math.round(c._score * 100) / 100;
    c.explanation = `Addresses ${relevant.join(' and ')} gap${relevant.length > 1 ? 's' : ''}; mapped to the ${profile?.jobRole ?? 'selected'} role and prioritised by current level and learning history.`;
    if (unmetByCourse.has(c.id)) c.explanation += ' A prerequisite is recommended first.';
    c.gapLabels = relevant.map(name => classifyGap(gapById.get(comps.find(x => x.name === name)?.id)?.gap ?? 0));
    delete c._score; delete c._gaps;
    return c;
  }).sort((a,b) => b.score-a.score || a.hours-b.hours);
  const byId=new Map(selected.map(course=>[course.id,course]));
  const visited=new Set(),visiting=new Set(),ordered=[];
  const addWithPrerequisites=course=>{
    if(visited.has(course.id)||visiting.has(course.id))return;
    visiting.add(course.id);
    for(const prerequisiteId of unmetByCourse.get(course.id)??[]){
      let prerequisite=byId.get(prerequisiteId);
      if(!prerequisite){
        const raw=grouped.get(prerequisiteId);
        if(raw){
          const relevant=[...new Set(raw._gaps)];
          prerequisite={...raw,score:course.score+0.01,explanation:`Complete this prerequisite before “${course.title}” to prepare for ${profile?.jobRole??'your role'}.`,gapLabels:relevant.map(name=>classifyGap(gapById.get(comps.find(x=>x.name===name)?.id)?.gap??0))};
          delete prerequisite._score;delete prerequisite._gaps;byId.set(prerequisiteId,prerequisite);
        }
      }
      if(prerequisite)addWithPrerequisites(prerequisite);
    }
    visiting.delete(course.id);visited.add(course.id);ordered.push(course);
  };
  for(const course of selected)addWithPrerequisites(course);
  await db.prepare('DELETE FROM recommendations WHERE user_id=?').run(userId);
  const save = db.prepare('INSERT INTO recommendations(user_id,course_id,score,explanation) VALUES (?,?,?,?)');
  for (const c of ordered) await save.run(userId,c.id,c.score,c.explanation);
  return ordered;
}

function tokenize(value) {
  return [...new Set(String(value).toLowerCase().match(/[a-z0-9]+/g) ?? [])].filter(t => t.length >= MIN_TOKEN_LENGTH && !STOP_WORDS.has(t));
}

function cosineSimilarity(a,b) {
  if(!Array.isArray(a)||!Array.isArray(b)||a.length!==b.length||!a.length)return 0;
  let dot=0,aa=0,bb=0;
  for(let i=0;i<a.length;i++){dot+=a[i]*b[i];aa+=a[i]*a[i];bb+=b[i]*b[i];}
  return aa&&bb?dot/(Math.sqrt(aa)*Math.sqrt(bb)):0;
}

async function embedBatch(texts) {
  const provider=(process.env.AI_PROVIDER||'demo').toLowerCase();
  const baseUrl=process.env.AI_BASE_URL;
  const model=process.env.AI_EMBEDDING_MODEL;
  if(provider==='demo'||!baseUrl||!model)return [];
  try {
    const isOllama=provider==='ollama';
    const headers={'content-type':'application/json'};
    if(process.env.AI_API_KEY)headers.authorization=`Bearer ${process.env.AI_API_KEY}`;
    const response=await fetch(isOllama?`${baseUrl.replace(/\/$/,'')}/api/embed`:`${baseUrl.replace(/\/$/,'')}/embeddings`,{
      method:'POST',headers,signal:AbortSignal.timeout(12000),body:JSON.stringify({model,input:texts}),
    });
    if(!response.ok)return [];
    const payload=await response.json();
    const vectors=isOllama?payload.embeddings:payload.data?.map(item=>item.embedding);
    return Array.isArray(vectors)?vectors.map(vector=>Array.isArray(vector)&&vector.every(Number.isFinite)?vector:null):[];
  } catch { return []; }
}

async function embedText(text) {return (await embedBatch([text]))[0]??null;}

async function retrieve(db, question, limit = 3) {
  const terms = tokenize(question);
  if (!terms.length) return [];
  const rows = await db.prepare(`SELECT r.id,r.title,r.source,r.language,ch.page_reference pageReference,ch.content,c.name competency,ch.embedding_json
    FROM learning_resource_chunks ch JOIN learning_resources r ON r.id=ch.resource_id JOIN competencies c ON c.id=r.competency_id`).all();
  const queryEmbedding=await embedText(question);
  const vectorHits=queryEmbedding?rows.filter(r=>r.embedding_json).map(r=>({...r,score:cosineSimilarity(queryEmbedding,JSON.parse(r.embedding_json))})).sort((a,b)=>b.score-a.score):[];
  if(vectorHits.length)return vectorHits.filter(r=>r.score>=0.18).slice(0,limit).map(({embedding_json,...r})=>r);
  const lexical=rows.map(r => {
    const contentTokens = tokenize(`${r.title} ${r.competency} ${r.content}`);
    const set = new Set(contentTokens);
    const overlap = terms.reduce((n, term) => n + (set.has(term) ? 1 : 0), 0);
    const phraseBonus = String(question).toLowerCase().includes(r.competency.toLowerCase()) ? 0.5 : 0;
    const score = overlap / Math.max(terms.length, 1) + phraseBonus;
    return { ...r, score };
  }).filter(r => r.score >= 0.25).sort((a,b) => b.score-a.score);
  const unique=[];const seen=new Set();
  for(const row of lexical){if(seen.has(row.id))continue;seen.add(row.id);const {embedding_json,...clean}=row;unique.push(clean);if(unique.length>=limit)break;}
  return unique;
}

function excerptFor(resource, query) {
  const sentences = resource.content.match(/[^.!?]+[.!?]?/g) ?? [resource.content];
  const queryTerms = new Set(tokenize(query));
  const scored = sentences.map(sentence => ({ sentence: sentence.trim(), score: tokenize(sentence).reduce((n,t) => n + Number(queryTerms.has(t)), 0) }));
  return scored.sort((a,b) => b.score-a.score).slice(0, 2).map(s => s.sentence).filter(Boolean).join(' ');
}

async function generateGroundedAnswer(query, resources) {
  if (!resources.length) return { answer: 'I could not find this information in the available learning sources.', provider: 'grounded-demo' };
  const provider = (process.env.AI_PROVIDER || 'demo').toLowerCase();
  const baseUrl = process.env.AI_BASE_URL;
  const model = process.env.AI_MODEL;
  if (provider !== 'demo' && baseUrl && model) {
    const context = resources.map(r => `[${r.title}, ${r.pageReference}] ${r.content}`).join('\n\n');
    try {
      const isOllama = provider === 'ollama';
      const url = isOllama ? `${baseUrl.replace(/\/$/,'')}/api/chat` : `${baseUrl.replace(/\/$/,'')}/chat/completions`;
      const headers = { 'content-type': 'application/json' };
      if (process.env.AI_API_KEY) headers.authorization = `Bearer ${process.env.AI_API_KEY}`;
      const response = await fetch(url, { method: 'POST', headers, signal: AbortSignal.timeout(12000), body: JSON.stringify(isOllama ? {
        model, stream: false, messages: [{ role: 'system', content: 'Answer only using the provided learning sources. If they do not contain the answer, say exactly: I could not find this information in the available learning sources.' }, { role: 'user', content: `Sources:\n${context}\n\nQuestion: ${query}` }]
      } : {
        model, temperature: 0.1, messages: [{ role: 'system', content: 'Answer only using the provided learning sources. If they do not contain the answer, say exactly: I could not find this information in the available learning sources.' }, { role: 'user', content: `Sources:\n${context}\n\nQuestion: ${query}` }]
      }) });
      if (!response.ok) throw new Error(`AI provider returned ${response.status}`);
      const body = await response.json();
      const answer = isOllama ? body.message?.content : body.choices?.[0]?.message?.content;
      if (typeof answer === 'string' && answer.trim()) return { answer: answer.trim(), provider };
    } catch {
      // The answer below is still grounded in the retrieved demo corpus and the mode is reported.
    }
  }
  const excerpts = resources.slice(0,2).map(r => excerptFor(r,query)).filter(Boolean);
  return { answer: `From the available learning material: ${excerpts.join(' ')}`, provider: provider === 'demo' ? 'grounded-demo' : 'grounded-demo-fallback' };
}

async function dashboard(db, userId) {
  await saveGaps(db,userId);
  const user = await profileOf(db, userId);
  const competencies = await competenciesOf(db, userId);
  const evaluated = competencies.filter(c => c.requiredLevel != null);
  const readiness = evaluated.length ? Math.round(evaluated.reduce((sum,c) => sum + Math.min(1,c.currentLevel/Math.max(c.requiredLevel,1)),0)/evaluated.length*100) : 0;
  const gaps = evaluated.filter(c => c.gap > 0).sort((a,b) => b.gap-a.gap);
  const progress = await db.prepare('SELECT COUNT(*) total,SUM(CASE WHEN status=\'completed\' THEN 1 ELSE 0 END) completed,COALESCE(SUM(CASE WHEN status=\'completed\' THEN c.duration_hours ELSE 0 END),0) hours FROM user_course_progress p JOIN courses c ON c.id=p.course_id WHERE p.user_id=?').get(userId);
  const latest = await db.prepare('SELECT score,total_questions,submitted_at FROM assessment_attempts WHERE user_id=? AND status=\'submitted\' ORDER BY submitted_at DESC LIMIT 1').get(userId);
  const activity = await db.prepare('SELECT action,entity_type,created_at FROM audit_logs WHERE user_id=? ORDER BY created_at DESC,id DESC LIMIT 5').all(userId);
  const recommendations = (await recommendationList(db,userId)).slice(0,3);
  return { user, readiness, gapCount:gaps.length, criticalCount:gaps.filter(g=>g.gap>=4).length, learningHours:progress.hours ?? 0, enrolledCount:progress.total ?? 0, completedCount:progress.completed ?? 0, latestAssessment:latest ? {score:latest.score,total:latest.total_questions,submittedAt:latest.submitted_at} : null, competencies, priorityGaps:gaps.slice(0,4).map(c=>({...c,gapLabel:classifyGap(c.gap)})), recommendations, activity, synthetic:Boolean(user?.isSynthetic) };
}

