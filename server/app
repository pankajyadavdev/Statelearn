function questionLevel(percent) {
  if (percent >= 90) return 5;
  if (percent >= 80) return 4;
  if (percent >= 65) return 3;
  if (percent >= 50) return 2;
  if (percent >= 30) return 1;
  return 0;
}

function publicQuestion(row) {
  return { id:row.id, competencyId:row.competency_id, competency:row.competency_name, question:row.question, options:JSON.parse(row.options_json) };
}

function fallbackDocumentChunks(text, size=1200, overlap=180) {
  const chunks=[];let start=0;
  while(start<text.length&&chunks.length<500){
    let end=Math.min(text.length,start+size);
    if(end<text.length){const boundary=text.lastIndexOf(' ',end);if(boundary>start+size*.65)end=boundary;}
    const value=text.slice(start,end).trim();if(value)chunks.push({text:value,metadata:{}});
    if(end>=text.length)break;start=Math.max(start+1,end-overlap);
  }
  return chunks;
}

function isValidGeneratedQuestion(item) {
  return item&&typeof item.question==='string'&&item.question.trim().length>=12&&item.question.length<=600&&
    Array.isArray(item.options)&&item.options.length>=2&&item.options.length<=5&&
    item.options.every(option=>typeof option==='string'&&option.trim().length>0&&option.length<=250)&&
    new Set(item.options.map(option=>option.trim().toLowerCase())).size===item.options.length&&
    Number.isInteger(item.correctIndex)&&item.correctIndex>=0&&item.correctIndex<item.options.length&&
    typeof item.explanation==='string'&&item.explanation.trim().length>=8;
}

async function generateQuestionFromSource(db, competencyId) {
  const competency=await db.prepare('SELECT id,name FROM competencies WHERE id=? AND active=1').get(competencyId);
  if(!competency)throw err(404,'Competency was not found.');
  const source=await db.prepare(`SELECT r.id resource_id,r.title,r.page_reference,ch.page_reference chunk_page,ch.content
    FROM learning_resources r JOIN learning_resource_chunks ch ON ch.resource_id=r.id
    WHERE r.competency_id=? ORDER BY r.is_synthetic,r.id,ch.chunk_index LIMIT 1`).get(competencyId);
  if(!source)throw err(422,'Add a learning source for this competency before generating a question.');
  const text=source.content.split(/(?<=[.!?])\s+/).map(sentence=>sentence.trim()).find(sentence=>sentence.length>=32)??source.content.slice(0,240).trim();
  const provider=(process.env.AI_PROVIDER||'demo').toLowerCase();
  let item=null;
  if(provider!=='demo'&&process.env.AI_BASE_URL&&process.env.AI_MODEL){
    try{
      const isOllama=provider==='ollama';const base=process.env.AI_BASE_URL.replace(/\/$/,'');const headers={'content-type':'application/json'};
      if(process.env.AI_API_KEY)headers.authorization=`Bearer ${process.env.AI_API_KEY}`;
      const prompt=`Create exactly one source-grounded multiple-choice assessment question. Return JSON only with question, options (2-5 unique strings), correctIndex (zero-based integer), explanation. Competency: ${competency.name}. Source: ${source.title} page ${source.chunk_page}. Text: ${text}`;
      const response=await fetch(isOllama?`${base}/api/chat`:`${base}/chat/completions`,{method:'POST',headers,signal:AbortSignal.timeout(12000),body:JSON.stringify(isOllama?{model:process.env.AI_MODEL,stream:false,format:'json',messages:[{role:'user',content:prompt}]}:{model:process.env.AI_MODEL,temperature:0.1,response_format:{type:'json_object'},messages:[{role:'user',content:prompt}]})});
      if(response.ok){const data=await response.json();const content=isOllama?data.message?.content:data.choices?.[0]?.message?.content;item=JSON.parse(content);}
    }catch{}
  }
  if(!isValidGeneratedQuestion(item)){
    item={question:`According to “${source.title}”, which statement supports ${competency.name.toLowerCase()}?`,options:[text.slice(0,240),'Keep the method undocumented and skip validation.','Assume all units and results are interchangeable.','Make decisions without checking the available evidence.'],correctIndex:0,explanation:`The cited source states: ${text.slice(0,420)}`};
  }
  const normalized=item.question.toLowerCase().replace(/[^a-z0-9]+/g,' ').trim();
  const duplicates=(await db.prepare('SELECT question FROM assessment_questions WHERE competency_id=?').all(competencyId)).some(row=>row.question.toLowerCase().replace(/[^a-z0-9]+/g,' ').trim()===normalized);
  if(duplicates)throw err(409,'A matching question already exists. Add another source or draft a different question.');
  return {item,source,competency,provider:provider==='demo'?'grounded-demo':provider};
}

async function analytics(db) {
  for (const row of await db.prepare('SELECT id FROM users WHERE deleted_at IS NULL').all()) await saveGaps(db,row.id);
  const summary = await db.prepare(`SELECT
      (SELECT COUNT(*) FROM users WHERE deleted_at IS NULL) officials,
      (SELECT COUNT(DISTINCT p.user_id) FROM user_course_progress p JOIN users u ON u.id=p.user_id WHERE p.status='in_progress' AND u.deleted_at IS NULL) activeLearners,
      (SELECT COALESCE(AVG(a.score),0) FROM assessment_attempts a JOIN users u ON u.id=a.user_id WHERE a.status='submitted' AND u.deleted_at IS NULL) averageAssessment`).get();
  const departments = await db.prepare(`SELECT d.name department,COUNT(DISTINCT u.id) officials,COUNT(DISTINCT CASE WHEN p.status='completed' THEN p.user_id END) learnersCompleted
    FROM departments d LEFT JOIN users u ON u.department_id=d.id AND u.deleted_at IS NULL LEFT JOIN user_course_progress p ON p.user_id=u.id GROUP BY d.id ORDER BY d.name`).all();
  const gaps = await db.prepare(`SELECT c.name competency,COUNT(*) officials,SUM(g.gap) gapPoints,MAX(g.gap) maxGap
    FROM skill_gaps g JOIN competencies c ON c.id=g.competency_id JOIN users u ON u.id=g.user_id
    WHERE u.deleted_at IS NULL GROUP BY c.id ORDER BY gapPoints DESC,c.name LIMIT 8`).all();
  const courseEffectiveness = await db.prepare(`SELECT c.title course,COUNT(p.id) enrollments,
      SUM(CASE WHEN p.status='completed' THEN 1 ELSE 0 END) completions,
      ROUND(CASE WHEN COUNT(p.id)=0 THEN 0 ELSE 100.0*SUM(CASE WHEN p.status='completed' THEN 1 ELSE 0 END)/COUNT(p.id) END,1) completionRate
    FROM courses c LEFT JOIN user_course_progress p ON p.course_id=c.id GROUP BY c.id ORDER BY enrollments DESC,c.title LIMIT 6`).all();
  return { ...summary, departments, topGaps:gaps, courseEffectiveness, synthetic:false, label:'Current platform analytics' };
}

async function predictiveScenario(db) {
  const rows=await db.prepare(`SELECT c.id,c.name competency,j.priority,COUNT(DISTINCT u.id) evaluatedLearners,
      COUNT(DISTINCT CASE WHEN uc.current_level<j.required_level THEN u.id END) learnersBelow,
      COALESCE(AVG(CASE WHEN u.id IS NOT NULL THEN GREATEST(0,j.required_level-COALESCE(uc.current_level,0)) END),0) averageGap,
      COUNT(DISTINCT cc.course_id) mappedCourses
    FROM competencies c JOIN job_role_competencies j ON j.competency_id=c.id
    LEFT JOIN users u ON u.job_role_id=j.job_role_id AND u.deleted_at IS NULL
    LEFT JOIN user_competencies uc ON uc.user_id=u.id AND uc.competency_id=c.id
    LEFT JOIN course_competencies cc ON cc.competency_id=c.id
    WHERE c.active=1 GROUP BY c.id,j.priority ORDER BY c.name`).all();
  const items=rows.map(row=>{
    const evaluated=Number(row.evaluatedLearners)||0;const below=Number(row.learnersBelow)||0;const averageGap=Number(row.averageGap)||0;
    const shortageRate=evaluated?below/evaluated:0;
    return {...row,evaluatedLearners:evaluated,learnersBelow:below,averageGap:Math.round(averageGap*100)/100,
      demandScore:Math.round((shortageRate*.65+averageGap/5*.35)*100),
      suggestedAction:row.mappedCourses?'Prioritise the mapped learning content.':'Create or source learning content for this skill.'};
  }).sort((a,b)=>b.demandScore-a.demandScore||b.learnersBelow-a.learnersBelow).slice(0,8);
  return {mode:'gap-analysis',label:'Current training demand',synthetic:false,
    method:'Priority scores summarise current competency gaps among registered learners. They are not a forecast.',
    population:(await db.prepare("SELECT COUNT(*) count FROM users WHERE deleted_at IS NULL AND job_role_id IS NOT NULL").get()).count,
    generatedAt:new Date().toISOString(),items};
}

export function createAppServer({ db }) {
  const loginAttempts = new Map();
  const rateBuckets = new Map();
  const server = createServer(async (req,res) => {
    res.setHeader('x-content-type-options','nosniff');
    res.setHeader('referrer-policy','same-origin');
    res.setHeader('x-frame-options','DENY');
    res.setHeader('cross-origin-resource-policy','same-origin');
    res.setHeader('content-security-policy',"default-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'");
    res.setHeader('permissions-policy','camera=(), microphone=(), geolocation=()');
    const url = new URL(req.url, 'http://localhost');
    const path = url.pathname;
    try {
      if(path.startsWith('/api/')&&['POST','PATCH','PUT','DELETE'].includes(req.method)&&path!=='/api/auth/login'){
        const policy=path==='/api/auth/register'?{limit:5,window:3600000,key:'register'}:path==='/api/resources/upload'?{limit:12,window:3600000,key:'upload'}:path==='/api/assistant/chat'?{limit:40,window:60000,key:'assistant'}:{limit:120,window:60000,key:'mutations'};
        const bucketKey=`${req.socket.remoteAddress??'unknown'}:${policy.key}`;const now=Date.now();let bucket=rateBuckets.get(bucketKey);
        if(!bucket||now-bucket.started>=policy.window)bucket={started:now,count:0};
        if(bucket.count>=policy.limit)return json(res,429,{error:'Request limit reached. Try again later.'},{'retry-after':String(Math.ceil((bucket.started+policy.window-now)/1000))});
        bucket.count+=1;rateBuckets.set(bucketKey,bucket);
        if(rateBuckets.size>5000)for(const [key,value] of rateBuckets)if(now-value.started>3600000)rateBuckets.delete(key);
      }
      if (req.method === 'GET' && path === '/api/health') return json(res,200,{status:'ok',app:'StatLearn'});
      if (req.method === 'GET' && path === '/api/ready') {
        await db.prepare('SELECT 1').get();
        return json(res,200,{status:'ready',database:'postgresql'});
      }
      if(req.method==='POST'&&path==='/api/auth/register') {
        checkOrigin(req);
        const body=await readBody(req);const name=String(body.name??'').trim();const email=String(body.email??'').trim().toLowerCase();const password=String(body.password??'');
        if(name.length<2||name.length>100)throw err(400,'Name must contain between 2 and 100 characters.');
        if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)||email.length>254)throw err(400,'Enter a valid email address.');
        if(password.length<10||password.length>128)throw err(400,'Password must contain 10 to 128 characters.');
        if(await db.prepare('SELECT 1 FROM users WHERE email=?').get(email))throw err(409,'An account with this email already exists.');
        const departmentId=(await db.prepare('SELECT id FROM departments WHERE name=?').get(process.env.DEFAULT_DEPARTMENT || 'General')).id;
        const organizationId=(await db.prepare('SELECT id FROM organizations WHERE name=?').get(process.env.DEFAULT_ORGANIZATION || 'My Organization')).id;
        const jobRoleId=(await db.prepare('SELECT id FROM job_roles WHERE name=?').get(process.env.DEFAULT_JOB_ROLE || 'Statistical Data Analyst')).id;
        const learnerRoleId=(await db.prepare('SELECT id FROM roles WHERE name=?').get('Learner')).id;
        const created=await db.prepare(`INSERT INTO users(name,email,password_hash,role_id,department_id,organization_id,job_role_id,designation,career_goals,languages,is_synthetic)
          VALUES (?,?,?,?,?,?,?,'Official','Build practical skills for high-quality statistical work','English',0)`).run(name,email,hashPassword(password),learnerRoleId,departmentId,organizationId,jobRoleId);
        const userId=Number(created.lastInsertRowid);
        await db.prepare('INSERT INTO user_roles(user_id,role_id) VALUES (?,?)').run(userId,learnerRoleId);
        await db.prepare('INSERT INTO user_competencies(user_id,competency_id,self_level,assessment_level,current_level,confidence) SELECT ?,id,0,NULL,0,0.35 FROM competencies WHERE active=1').run(userId);
        await saveGaps(db,userId);await audit(db,userId,'account_registered','user',userId,{role:'Learner'});
        await notifyUser(db,userId,'Welcome to StatLearn','Your learning profile is ready. Review your competencies and start an assessment.','learning');
        const token=randomBytes(32).toString('base64url');const expires=new Date(Date.now()+SESSION_DAYS*86400000).toISOString();
        await db.prepare('INSERT INTO sessions(user_id,token_hash,expires_at) VALUES (?,?,?)').run(userId,toHash(token),expires);
        const secure=process.env.NODE_ENV==='production'?'; Secure':'';
        return json(res,201,{user:await profileOf(db,userId)},{'set-cookie':`${COOKIE}=${encodeURIComponent(token)}; Path=/; HttpOnly; SameSite=Lax; Max-Age=${SESSION_DAYS*86400}${secure}`});
      }
      if (req.method === 'POST' && path === '/api/auth/login') {
        checkOrigin(req);
        const body = await readBody(req);
        const email = String(body.email ?? '').trim().toLowerCase();
        const password = String(body.password ?? '');
        const ip = req.socket.remoteAddress ?? 'unknown';
        const attempt = loginAttempts.get(ip) ?? { count:0, reset:Date.now()+15*60*1000 };
        if (Date.now() > attempt.reset) { attempt.count=0; attempt.reset=Date.now()+15*60*1000; }
        if (attempt.count >= 10) return json(res,429,{error:'Too many sign-in attempts. Try again in 15 minutes.'});
        const row = await db.prepare('SELECT id,password_hash FROM users WHERE email=? AND deleted_at IS NULL').get(email);
        if (!row || !verifyPassword(password,row.password_hash)) {
          attempt.count += 1; loginAttempts.set(ip,attempt);
          return json(res,401,{error:'Email or password is incorrect.'});
        }
        loginAttempts.delete(ip);
        const token = randomBytes(32).toString('base64url');
        const expires = new Date(Date.now()+SESSION_DAYS*86400000).toISOString();
        await db.prepare('INSERT INTO sessions(user_id,token_hash,expires_at) VALUES (?,?,?)').run(row.id,toHash(token),expires);
        await audit(db,row.id,'login','session');
        const secure = process.env.NODE_ENV === 'production' ? '; Secure' : '';
        return json(res,200,{user:await profileOf(db,row.id)},{'set-cookie':`${COOKIE}=${encodeURIComponent(token)}; Path=/; HttpOnly; SameSite=Lax; Max-Age=${SESSION_DAYS*86400}${secure}`});
      }
      if (req.method === 'POST' && path === '/api/auth/logout') {
        checkOrigin(req);
        const token = parseCookies(req.headers.cookie)[COOKIE];
        const user = await currentUser(db,req);
        if (token) await db.prepare('DELETE FROM sessions WHERE token_hash=?').run(toHash(token));
        if (user) await audit(db,user.id,'logout','session');
        return json(res,200,{ok:true},{'set-cookie':`${COOKIE}=; Path=/; HttpOnly; SameSite=Lax; Max-Age=0`});
      }

      const user = await currentUser(db,req);
      if (path.startsWith('/api/') && !user) return json(res,401,{error:'Sign in to continue.'});

      if (req.method === 'GET' && path === '/api/auth/me') return json(res,200,{user:await profileOf(db,user.id)});
      if (req.method === 'GET' && path === '/api/dashboard') return json(res,200,await dashboard(db,user.id));
      if (req.method === 'GET' && path === '/api/profile') return json(res,200,await profileOf(db,user.id));
      if (req.method === 'PATCH' && path === '/api/profile') {
        checkOrigin(req);
        const body = await readBody(req);
        const allowed = { name:'name',designation:'designation',experienceYears:'experience_years',education:'education',careerGoals:'career_goals',languages:'languages',previousTraining:'previous_training',certifications:'certifications',currentAssignment:'current_assignment' };
        const updates = Object.entries(allowed).filter(([key]) => body[key] !== undefined);
        if (!updates.length) throw err(400,'Provide at least one profile field to update.');
        if (body.name !== undefined && (typeof body.name !== 'string' || body.name.trim().length < 2 || body.name.length > 100)) throw err(400,'Name must contain between 2 and 100 characters.');
        if (body.experienceYears !== undefined && (!Number.isFinite(Number(body.experienceYears)) || Number(body.experienceYears)<0 || Number(body.experienceYears)>60)) throw err(400,'Experience must be between 0 and 60 years.');
        for (const [key,column] of updates) await db.prepare(`UPDATE users SET ${column}=?,updated_at=CURRENT_TIMESTAMP WHERE id=?`).run(key==='experienceYears' ? Number(body[key]) : String(body[key]).slice(0,2000),user.id);
        await audit(db,user.id,'profile_updated','user',user.id,{ fields:updates.map(([key])=>key) });
        return json(res,200,await profileOf(db,user.id));
      }
      if (req.method === 'GET' && path === '/api/competencies') return json(res,200,{items:await competenciesOf(db,user.id),levels:await db.prepare('SELECT level,label FROM competency_levels ORDER BY level').all()});
      if (req.method === 'PATCH' && /^\/api\/competencies\/\d+$/.test(path)) {
        checkOrigin(req);
        const competencyId = Number(path.split('/').at(-1));
        const body = await readBody(req);
        const level = Number(body.selfLevel);
        if (!Number.isInteger(level)||level<0||level>5) throw err(400,'Self-assessed level must be an integer from 0 to 5.');
        const existing = await db.prepare('SELECT assessment_level FROM user_competencies WHERE user_id=? AND competency_id=?').get(user.id,competencyId);
        if (!existing) throw err(404,'Competency was not found.');
        const current = existing.assessment_level == null ? level : Math.round(level*0.4+existing.assessment_level*0.6);
        await db.prepare('UPDATE user_competencies SET self_level=?,current_level=?,confidence=?,updated_at=CURRENT_TIMESTAMP WHERE user_id=? AND competency_id=?').run(level,current,existing.assessment_level==null?0.45:0.85,user.id,competencyId);
        await db.prepare('INSERT INTO competency_evidence(user_id,competency_id,source,score,level,confidence,detail) VALUES (?,?,?,?,?,?,?)').run(user.id,competencyId,'self_assessment',level*20,level,0.45,'Self assessment submitted by learner.');
        await saveGaps(db,user.id); await audit(db,user.id,'competency_updated','competency',competencyId,{source:'self_assessment',level});
        await notifyUser(db,user.id,'Competency profile updated','Your self-assessment was saved and role skill gaps were recalculated.','skill_gap');
        return json(res,200,(await competenciesOf(db,user.id)).find(c=>c.id===competencyId));
      }
      if (req.method === 'GET' && path === '/api/catalog') return json(res,200,{items:await db.prepare(`SELECT c.id,c.title,c.description summary,c.provider,c.provider_type providerType,c.duration_hours hours,c.difficulty,c.language,c.is_synthetic isSynthetic,
        STRING_AGG(co.name, ' · ') competencies,COALESCE(p.status,'') progressStatus,COALESCE(p.progress_percent,0) progressPercent
        FROM courses c JOIN course_competencies cc ON cc.course_id=c.id JOIN competencies co ON co.id=cc.competency_id
        LEFT JOIN user_course_progress p ON p.course_id=c.id AND p.user_id=? WHERE c.active=1 GROUP BY c.id ORDER BY c.title`).all(user.id)});
      if (req.method === 'GET' && path === '/api/recommendations') return json(res,200,{items:await recommendationList(db,user.id)});
      if (req.method === 'GET' && path === '/api/learning/path') {
        const items = (await recommendationList(db,user.id)).slice(0,5).map((course,index)=>({stage:index+1,...course}));
        await db.prepare('DELETE FROM learning_path_items WHERE user_id=?').run(user.id);
        const pathId = randomUUID();
        await db.prepare('INSERT INTO learning_paths(id,user_id,title,updated_at) VALUES (?,?,?,CURRENT_TIMESTAMP)').run(pathId,user.id,'Personalised competency pathway');
        const insert = db.prepare('INSERT INTO learning_path_items(path_id,user_id,course_id,stage,status) VALUES (?,?,?,?,?)');
        for(const item of items) await insert.run(pathId,user.id,item.id,item.stage,item.progressStatus||'recommended');
        return json(res,200,{title:'Personalised competency pathway',items,updatedAt:new Date().toISOString(),synthetic:false});
      }
      if (req.method === 'POST' && /^\/api\/courses\/\d+\/enroll$/.test(path)) {
        checkOrigin(req);
        const courseId=Number(path.split('/')[3]);
        if (!await db.prepare('SELECT 1 FROM courses WHERE id=? AND active=1').get(courseId)) throw err(404,'Course was not found.');
        await db.prepare(`INSERT INTO user_course_progress(user_id,course_id,status,progress_percent) VALUES (?,?,'in_progress',0)
          ON CONFLICT(user_id,course_id) DO UPDATE SET status=CASE WHEN status='completed' THEN status ELSE 'in_progress' END`).run(user.id,courseId);
        await audit(db,user.id,'course_enrolled','course',courseId);
        await notifyUser(db,user.id,'Learning path updated','A course was added to your learning activity.','learning_path');
        return json(res,200,{ok:true,courseId});
      }
      if (req.method === 'POST' && /^\/api\/courses\/\d+\/complete$/.test(path)) {
        checkOrigin(req);
        const courseId=Number(path.split('/')[3]);
        const course=await db.prepare('SELECT id,title FROM courses WHERE id=? AND active=1').get(courseId);
        if (!course) throw err(404,'Course was not found.');
        await db.prepare(`INSERT INTO user_course_progress(user_id,course_id,status,progress_percent,completed_at) VALUES (?,?,'completed',100,CURRENT_TIMESTAMP)
          ON CONFLICT(user_id,course_id) DO UPDATE SET status='completed',progress_percent=100,completed_at=CURRENT_TIMESTAMP`).run(user.id,courseId);
        const mapped=await db.prepare('SELECT competency_id,target_level FROM course_competencies WHERE course_id=?').all(courseId);
        for(const row of mapped) {
          const old=await db.prepare('SELECT self_level,current_level FROM user_competencies WHERE user_id=? AND competency_id=?').get(user.id,row.competency_id);
          const updated=Math.max(old.current_level,Math.min(row.target_level,old.current_level+1));
          await db.prepare('UPDATE user_competencies SET current_level=?,confidence=LEAST(1,confidence+0.1),updated_at=CURRENT_TIMESTAMP WHERE user_id=? AND competency_id=?').run(updated,user.id,row.competency_id);
          await db.prepare('INSERT INTO competency_evidence(user_id,competency_id,source,score,level,confidence,detail) VALUES (?,?,?,?,?,?,?)').run(user.id,row.competency_id,'course_assessment',updated*20,updated,0.65,`Completed ${course.title}. Completion is self-reported unless verified by a connected provider.`);
        }
        await saveGaps(db,user.id); await audit(db,user.id,'course_completed','course',courseId,{title:course.title});
        await notifyUser(db,user.id,'Course completion recorded',`Your completion of “${course.title}” was recorded. It is self-reported unless confirmed by a connected learning provider.`,'completion');
        return json(res,200,{ok:true,courseId,competencies:await competenciesOf(db,user.id)});
      }
      if (req.method === 'POST' && path === '/api/assessment/start') {
        checkOrigin(req);
        const rows=await db.prepare(`SELECT q.id,q.competency_id,c.name competency_name,q.question,q.options_json
          FROM assessment_questions q JOIN competencies c ON c.id=q.competency_id WHERE q.status='published' ORDER BY q.id`).all();
        if(rows.length<4) throw err(503,'Assessment question bank is not ready.');
        const questionIds=rows.map(q=>q.id);
        const id=randomUUID();
        await db.prepare('INSERT INTO assessment_attempts(id,user_id,question_ids_json,total_questions) VALUES (?,?,?,?)').run(id,user.id,JSON.stringify(questionIds),questionIds.length);
        await audit(db,user.id,'assessment_started','assessment',id,{questions:questionIds.length});
        return json(res,201,{attemptId:id,questions:rows.map(publicQuestion),total:questionIds.length});
      }
      if (req.method === 'POST' && /^\/api\/assessment\/[^/]+\/submit$/.test(path)) {
        checkOrigin(req);
        const attemptId=path.split('/')[3];
        const attempt=await db.prepare('SELECT * FROM assessment_attempts WHERE id=? AND user_id=?').get(attemptId,user.id);
        if(!attempt) throw err(404,'Assessment attempt was not found.');
        if(attempt.status==='submitted') throw err(409,'This attempt has already been submitted.');
        const body=await readBody(req);
        if(!body.answers||typeof body.answers!=='object'||Array.isArray(body.answers)) throw err(400,'Answers must be an object keyed by question id.');
        const questionIds=JSON.parse(attempt.question_ids_json);
        const questions=await Promise.all(questionIds.map(id=>db.prepare(`SELECT q.*,c.name competency_name,r.title source_title,r.page_reference FROM assessment_questions q JOIN competencies c ON c.id=q.competency_id LEFT JOIN learning_resources r ON r.id=q.source_id WHERE q.id=?`).get(id)));
        if(Object.keys(body.answers).length!==questions.length||questions.some(q=>!Number.isInteger(Number(body.answers[q.id])))) throw err(400,'Answer every question before submitting.');
        let correct=0;
        const perCompetency=new Map();
        const answerInsert=db.prepare('INSERT INTO assessment_answers(attempt_id,question_id,selected_index,is_correct) VALUES (?,?,?,?)');
        const feedback=[];
        for(const q of questions){
          const selected=Number(body.answers[q.id]);
          if(selected<0||selected>=JSON.parse(q.options_json).length) throw err(400,'An answer option is invalid.');
          const isCorrect=selected===q.correct_index;
          correct+=Number(isCorrect);
          const item=perCompetency.get(q.competency_id)??{correct:0,total:0};
          item.correct+=Number(isCorrect);item.total+=1;perCompetency.set(q.competency_id,item);
          await answerInsert.run(attemptId,q.id,selected,Number(isCorrect));
          feedback.push({questionId:q.id,competency:q.competency_name,question:q.question,options:JSON.parse(q.options_json),selectedIndex:selected,correctIndex:q.correct_index,isCorrect,explanation:q.explanation,source:q.source_title?{title:q.source_title,page:q.page_reference}:null});
        }
        const score=Math.round(correct/questions.length*100);
        const updateComp=db.prepare('UPDATE user_competencies SET assessment_level=?,current_level=?,confidence=?,updated_at=CURRENT_TIMESTAMP WHERE user_id=? AND competency_id=?');
        const evidence=db.prepare('INSERT INTO competency_evidence(user_id,competency_id,source,score,level,confidence,detail) VALUES (?,?,?,?,?,?,?)');
        for(const [competencyId,result] of perCompetency){
          const percent=Math.round(result.correct/result.total*100);
          const level=questionLevel(percent);
          const row=await db.prepare('SELECT self_level FROM user_competencies WHERE user_id=? AND competency_id=?').get(user.id,competencyId);
          const current=Math.round(row.self_level*0.4+level*0.6);
          await updateComp.run(level,current,Math.min(0.95,0.6+result.total*0.1),user.id,competencyId);
          await evidence.run(user.id,competencyId,'assessment',percent,level,Math.min(0.95,0.6+result.total*0.1),`Assessment evidence: ${result.correct}/${result.total} questions correct.`);
        }
        const submittedAt=new Date().toISOString();
        await db.prepare('UPDATE assessment_attempts SET status=\'submitted\',score=?,submitted_at=? WHERE id=?').run(score,submittedAt,attemptId);
        await saveGaps(db,user.id);
        await audit(db,user.id,'assessment_submitted','assessment',attemptId,{score,questionCount:questions.length,competenciesUpdated:perCompetency.size});
        const updated=await competenciesOf(db,user.id);
        const recommendations=(await recommendationList(db,user.id)).slice(0,3);
        await audit(db,user.id,'recommendation_refreshed','recommendation',null,{count:recommendations.length});
        await notifyUser(db,user.id,'Assessment feedback available',`Your ${score}% assessment result updated competency evidence, skill gaps, and recommendations.`,'assessment');
        if(updated.some(comp=>comp.gap>0))await notifyUser(db,user.id,'Skill gaps recalculated','Review your updated priority gaps and recommended courses.','skill_gap');
        return json(res,200,{attemptId,score,correct,total:questions.length,percentage:score,submittedAt,feedback,updatedCompetencies:updated.filter(c=>perCompetency.has(c.id)),recommendations,skillGaps:updated.filter(c=>c.gap>0).sort((a,b)=>b.gap-a.gap).slice(0,6)});
      }
      if (req.method === 'GET' && path === '/api/assessment/history') {
        return json(res,200,{items:await db.prepare(`SELECT id,score,total_questions total,submitted_at submittedAt,created_at createdAt FROM assessment_attempts WHERE user_id=? AND status='submitted' ORDER BY submitted_at DESC LIMIT 20`).all(user.id)});
