function parseCookies(header = '') {
  return Object.fromEntries(header.split(';').map(part => part.trim()).filter(Boolean).map(part => {
    const split = part.indexOf('=');
    return [part.slice(0, split), decodeURIComponent(part.slice(split + 1))];
  }));
}

async function readBody(req, limit = MAX_BODY_BYTES) {
  let size = 0;
  const chunks = [];
  for await (const chunk of req) {
    size += chunk.length;
    if (size > limit) throw err(413, 'Request body is too large.');
    chunks.push(chunk);
  }
  if (!size) return {};
  try { return JSON.parse(Buffer.concat(chunks).toString('utf8')); }
  catch { throw err(400, 'Request body must be valid JSON.'); }
}

async function readRawBody(req, limit = MAX_UPLOAD_BYTES) {
  let size=0;const chunks=[];
  for await(const chunk of req){size+=chunk.length;if(size>limit)throw err(413,'Document exceeds the 10 MB upload limit.');chunks.push(chunk);}
  if(!size)throw err(400,'The uploaded document is empty.');
  return Buffer.concat(chunks);
}

async function currentUser(db, req) {
  const token = parseCookies(req.headers.cookie)[COOKIE];
  if (!token || token.length < 40) return null;
  return (await db.prepare(`SELECT u.id,u.name,u.email,r.name AS role,u.department_id,d.name AS department,
      u.organization_id,o.name AS organization,u.job_role_id,j.name AS job_role,u.designation,
      u.experience_years,u.education,u.career_goals,u.languages,u.previous_training,u.certifications,
      u.current_assignment,u.is_synthetic
    FROM sessions s JOIN users u ON u.id=s.user_id JOIN roles r ON r.id=u.role_id
    LEFT JOIN departments d ON d.id=u.department_id LEFT JOIN organizations o ON o.id=u.organization_id
    LEFT JOIN job_roles j ON j.id=u.job_role_id
    WHERE s.token_hash=? AND s.expires_at>? AND u.deleted_at IS NULL`).get(toHash(token), new Date().toISOString())) ?? null;
}

function checkOrigin(req) {
  const origin = req.headers.origin;
  if (!origin) return;
  const allowed = new Set([
    process.env.APP_ORIGIN,
    'http://localhost:5173',
    'http://127.0.0.1:5173',
    'http://localhost:3000',
    'http://127.0.0.1:3000',
    'http://localhost:3001',
    'http://127.0.0.1:3001',
  ].filter(Boolean));
  if (!allowed.has(origin)) throw err(403, 'Request origin is not allowed.');
}

