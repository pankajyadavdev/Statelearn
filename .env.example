NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173

# Use PostgreSQL 17. For Docker Compose, the app uses the db hostname internally.
POSTGRES_DB=statlearn
POSTGRES_USER=statlearn
POSTGRES_PASSWORD=replace-with-a-strong-alphanumeric-password
DATABASE_URL=postgresql://statlearn:replace-with-a-strong-alphanumeric-password@127.0.0.1:5432/statlearn
DATABASE_POOL_SIZE=10

# Demo records are optional. Leave false for normal account registration and live data.
SEED_DEMO_DATA=false

# First System Admin account. Set both values once before first startup; use a 12+ character password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Platform Administrator

# Defaults assigned to new learner accounts.
DEFAULT_ORGANIZATION=My Organization
DEFAULT_DEPARTMENT=General
DEFAULT_JOB_ROLE=Statistical Data Analyst

# Keep demo for local grounded responses.
# Set to ollama or an OpenAI-compatible provider to enable configured AI calls.
AI_PROVIDER=demo
AI_BASE_URL=
AI_MODEL=
AI_EMBEDDING_MODEL=
AI_API_KEY=
