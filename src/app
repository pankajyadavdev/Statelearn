function AssessmentView({busy,onStart,onFinish,onNavigate}:{busy:boolean;onStart:()=>Promise<{attemptId:string;questions:Question[];total:number}>;onFinish:(attemptId:string,answers:Record<number,number>)=>Promise<Result>;onNavigate:(view:View)=>void}) {
  const [attemptId,setAttemptId]=useState('');const [questions,setQuestions]=useState<Question[]>([]);const [answers,setAnswers]=useState<Record<number,number>>({});const [result,setResult]=useState<Result|null>(null);const [step,setStep]=useState(0);const [starting,setStarting]=useState(false);const [submitting,setSubmitting]=useState(false);
