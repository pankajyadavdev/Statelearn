  return <><PageHeading eyebrow="ASSESS AND GROW" title="Competency assessments" description="Take a short skills check and use the results to refine your learning profile."/><div className="assessment-intro"><div className="assessment-intro-copy"><Badge tone="purple"><Sparkles size={12}/>PERSONALISED CHECK</Badge><h2>Make your next step<br/><em>more informed.</em></h2><p>This demo assessment spans survey design, sampling, data quality, digital practice, and analytical tools. Feedback includes explanations and source references.</p><div className="assessment-facts"><span><CheckCircle2 size={15}/>Immediate feedback</span><span><Target size={15}/>Competency evidence</span><span><Clock3 size={15}/>About 8 minutes</span></div><button className="primary-btn" disabled={starting||busy} onClick={()=>void begin()}>{starting||busy?<LoaderCircle size={16} className="spin"/>:<CheckCircle2 size={16}/>}Begin skills check<ArrowRight size={15}/></button></div><div className="assessment-visual"><div className="assessment-ring ring-outer"/><div className="assessment-ring ring-middle"/><div className="assessment-ring ring-inner"/><div className="assessment-center"><Target size={26}/></div><div className="assessment-chip chip-one"><Check size={13}/>Competency mapped</div><div className="assessment-chip chip-two"><Sparkles size={13}/>Feedback ready</div></div></div><div className="assessment-bottom-grid"><div className="panel"><Kicker>HOW IT WORKS</Kicker><h3>From answers to action</h3><div className="mini-steps"><div><span>01</span><strong>Answer questions</strong><small>See how you approach real concepts.</small></div><ArrowRight size={15}/><div><span>02</span><strong>Review feedback</strong><small>Understand correct answers and why.</small></div><ArrowRight size={15}/><div><span>03</span><strong>Update your path</strong><small>Use your new evidence to focus learning.</small></div></div></div><div className="panel assessment-history"><div><Kicker>YOUR HISTORY</Kicker><h3>Recent assessments</h3></div><p>New submissions and scores will appear here as you complete a skills check.</p></div></div></>;
