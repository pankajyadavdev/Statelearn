import { FormEvent, ReactNode, CSSProperties, useCallback, useEffect, useMemo, useState } from 'react';
import {
  Activity, ArrowDownRight, ArrowRight, ArrowUpRight, Award, BarChart3, Bell, BookOpen,
  Check, CheckCircle2, ChevronDown, ChevronRight, CircleHelp, Clock3, Compass, FileText,
  GraduationCap, LayoutDashboard, LoaderCircle, LockKeyhole, LogOut, MessageCircle, Plus,
  RefreshCw, Search, Send, ShieldCheck, Sparkles, Target, TrendingUp, UserRound, Users,
} from 'lucide-react';
import { api, patch, post, uploadDocument } from './api';

type User = { id:number; name:string; email:string; role:string; department:string; organization:string; jobRole:string; designation:string; experienceYears:number; education:string; careerGoals:string; languages:string; previousTraining:string; certifications:string; currentAssignment:string; isSynthetic:boolean };
type Competency = { id:number; name:string; description:string; category:string; selfLevel:number; currentLevel:number; confidence:number; requiredLevel:number|null; priority:string; gap:number; gapLabel?:string };
type Course = { id:number; title:string; summary:string; provider:string; providerType:string; hours:number; difficulty:string; language:string; competencies?:string|Array<{name:string;gap?:number}>; progressStatus?:string; progressPercent?:number; score?:number; explanation?:string; gapLabels?:string[]; isSynthetic:boolean };
type Dashboard = { user:User; readiness:number; gapCount:number; criticalCount:number; learningHours:number; enrolledCount:number; completedCount:number; latestAssessment:null|{score:number;total:number;submittedAt:string}; competencies:Competency[]; priorityGaps:Competency[]; recommendations:Course[]; activity:Array<{action:string;entity_type:string;created_at:string}>; synthetic:boolean };
type Question = { id:number; competencyId:number; competency:string; question:string; options:string[] };
type Feedback = { questionId:number; competency:string; question:string; options:string[]; selectedIndex:number; correctIndex:number; isCorrect:boolean; explanation:string; source?:{title:string;page:string}|null };
type Result = { score:number; correct:number; total:number; percentage:number; feedback:Feedback[]; updatedCompetencies:Competency[]; recommendations:Course[]; skillGaps:Competency[] };
type Framework = { categories:Array<{id:number;name:string}>; competencies:Array<{id:number;name:string;description:string;active:number;category:string}>; roles:Array<{id:number;name:string;description:string}>; learners:Array<{id:number;name:string;email:string;jobRoleId:number|null;jobRole:string}>; mappings:Array<{jobRoleId:number;competencyId:number;requiredLevel:number;priority:string;roleName:string;competencyName:string}>; levels:Array<{level:number;label:string}> };
type PredictionReport = { mode:string; label:string; synthetic:boolean; method:string; population:number; generatedAt:string; items:Array<{competency:string;priority:string;evaluatedLearners:number;learnersBelow:number;averageGap:number;mappedCourses:number;demandScore:number;suggestedAction:string}> };
type View = 'dashboard'|'competencies'|'learning'|'assistant'|'assessment'|'profile'|'trainer'|'admin';

const levelLabels = ['Not yet demonstrated','Beginner','Basic','Intermediate','Advanced','Expert'];
const navItems:Array<{id:View;label:string;icon:typeof LayoutDashboard;group:string;roles?:string[]}> = [
  {id:'dashboard',label:'Overview',icon:LayoutDashboard,group:'WORKSPACE'},
  {id:'competencies',label:'My competencies',icon:Target,group:'WORKSPACE'},
  {id:'learning',label:'Learning library',icon:BookOpen,group:'WORKSPACE'},
  {id:'assistant',label:'Learning assistant',icon:Sparkles,group:'WORKSPACE'},
  {id:'assessment',label:'Assessments',icon:CheckCircle2,group:'WORKSPACE'},
  {id:'trainer',label:'Trainer studio',icon:GraduationCap,group:'MANAGE',roles:['Trainer','System Admin']},
  {id:'admin',label:'Department insights',icon:BarChart3,group:'MANAGE',roles:['Department Admin','System Admin']},
];

function initials(name='') { return name.split(/\s+/).slice(0,2).map(part=>part[0]??'').join('').toUpperCase(); }
function greeting() { const hour=new Date().getHours(); return hour<12?'Good morning':hour<17?'Good afternoon':'Good evening'; }
function pretty(value:string) { return value.replaceAll('_',' ').replace(/\b\w/g,letter=>letter.toUpperCase()); }
function competencyNames(course:Course) { return Array.isArray(course.competencies)?course.competencies.map(item=>item.name):String(course.competencies??'').split(' · ').filter(Boolean); }

function Brand({compact=false}:{compact?:boolean}) {
  return <div className={`brand ${compact?'brand-compact':''}`}><div className="brand-mark"><span></span><span></span><span></span><span></span></div><div><strong>statlearn</strong><small>OFFICIAL STATISTICS</small></div></div>;
}

function Kicker({children}:{children:string}) { return <div className="kicker">{children}</div>; }
function PageHeading({eyebrow,title,description,actions}:{eyebrow:string;title:string;description:string;actions?:React.ReactNode}) {
  return <div className="page-heading"><div><Kicker>{eyebrow}</Kicker><h1>{title}</h1><p>{description}</p></div>{actions&&<div className="heading-actions">{actions}</div>}</div>;
}
function Badge({children,tone='muted'}:{children:ReactNode;tone?:'muted'|'green'|'amber'|'red'|'blue'|'purple'}) { return <span className={`badge badge-${tone}`}>{children}</span>; }
function Progress({value,tone='teal'}:{value:number;tone?:'teal'|'blue'|'amber'}) { return <div className={`progress progress-${tone}`}><span style={{width:`${Math.max(0,Math.min(100,value))}%`}} /></div>; }
function Empty({icon:Icon=CircleHelp,title,description}:{icon?:typeof CircleHelp;title:string;description:string}) { return <div className="empty"><div className="empty-icon"><Icon size={20}/></div><strong>{title}</strong><p>{description}</p></div>; }

export default function App() {
  const [user,setUser]=useState<User|null>(null);
  const [loading,setLoading]=useState(true);
  const [view,setView]=useState<View>('dashboard');
  const [dashboard,setDashboard]=useState<Dashboard|null>(null);
  const [competencies,setCompetencies]=useState<Competency[]>([]);
  const [courses,setCourses]=useState<Course[]>([]);
  const [notifications,setNotifications]=useState<Array<{id:number;title:string;message:string;readAt:string|null}>>([]);
  const [toast,setToast]=useState('');
  const [busy,setBusy]=useState(false);

  const notify=useCallback((message:string)=>{setToast(message);window.setTimeout(()=>setToast(''),3600);},[]);
  const loadCore=useCallback(async()=>{
    const [dash,comp,library,notes]=await Promise.all([
      api<Dashboard>('/dashboard'),api<{items:Competency[]}>('/competencies'),api<{items:Course[]}>('/catalog'),api<{items:Array<{id:number;title:string;message:string;readAt:string|null}>}>('/notifications'),
    ]);
    setDashboard(dash);setCompetencies(comp.items);setCourses(library.items);setNotifications(notes.items);
  },[]);

  useEffect(()=>{api<{user:User}>('/auth/me').then(async result=>{setUser(result.user);await loadCore();}).catch(()=>{}).finally(()=>setLoading(false));},[loadCore]);

  async function signIn(email:string,password:string) {
    setBusy(true);
    try { const result=await post<{user:User}>('/auth/login',{email,password});setUser(result.user);await loadCore();setView('dashboard'); }
    catch(error){notify(error instanceof Error?error.message:'Unable to sign in.');}
    finally{setBusy(false);}
  }

  async function signUp(name:string,email:string,password:string) {
    setBusy(true);
    try { const result=await post<{user:User}>('/auth/register',{name,email,password});setUser(result.user);await loadCore();setView('dashboard'); }
    catch(error){notify(error instanceof Error?error.message:'Unable to create your account.');}
    finally{setBusy(false);}
  }

  async function signOut() {
    setBusy(true);
    try{await post('/auth/logout');}catch{}
    setUser(null);setDashboard(null);setView('dashboard');setBusy(false);
  }

  async function refresh() {
    try{await loadCore();}catch(error){notify(error instanceof Error?error.message:'Could not refresh your workspace.');}
  }

  async function action<T>(work:()=>Promise<T>,success?:string) {
    setBusy(true);
    try{const result=await work();await loadCore();if(success)notify(success);return result;}
    catch(error){notify(error instanceof Error?error.message:'The action could not be completed.');throw error;}
    finally{setBusy(false);}
  }

  if(loading) return <div className="loading-screen"><div className="loader-logo"><Brand/></div><div className="loading-line"><span/></div><p>Preparing your learning workspace</p></div>;
  if(!user) return <Login onLogin={signIn} onRegister={signUp} busy={busy} toast={toast}/>;

  const allowedNav=navItems.filter(item=>!item.roles||item.roles.includes(user.role));
  const active=allowedNav.find(item=>item.id===view);
  return <div className="app-shell">
    <aside className="sidebar">
      <div className="sidebar-brand"><Brand/></div>
      <div className="demo-label"><span className="status-dot"/>LEARNING PLATFORM</div>
      {['WORKSPACE','MANAGE'].map(group=>{
        const items=allowedNav.filter(item=>item.group===group);if(!items.length)return null;
        return <div className="nav-group" key={group}><div className="nav-caption">{group}</div>{items.map(item=>{
          const Icon=item.icon;return <button key={item.id} className={`nav-item ${view===item.id?'active':''}`} aria-label={item.label} title={item.label} onClick={()=>setView(item.id)}><Icon size={17}/><span>{item.label}</span>{item.id==='assistant'&&<i className="nav-new">AI</i>}</button>;
        })}</div>;
      })}
      <div className="sidebar-spacer"/>
      <div className="side-note"><div className="side-note-icon"><ShieldCheck size={17}/></div><div><strong>Built for public service</strong><p>Practical learning for official statistics.</p></div></div>
      <button className="profile-switch" onClick={()=>setView('profile')}><div className="avatar">{initials(user.name)}</div><div className="profile-switch-copy"><strong>{user.name}</strong><span>{user.role}</span></div><ChevronDown size={15}/></button>
      <button className="logout-btn" onClick={signOut} disabled={busy}><LogOut size={15}/>Sign out</button>
    </aside>

    <main className="main-area">
      <header className="topbar">
        <div className="breadcrumbs"><span>Workspace</span><ChevronRight size={14}/><strong>{active?.label??'Overview'}</strong></div>
        <div className="topbar-actions"><span className="topbar-provider"><span className="status-dot"/>Platform ready</span><button className="icon-btn notification-btn" aria-label="Notifications" onClick={()=>{const item=notifications.find(notification=>!notification.readAt);if(!item){notify('You are all caught up.');return;}notify(`${item.title}: ${item.message}`);void patch(`/notifications/${item.id}/read`,{}).then(()=>setNotifications(current=>current.map(notification=>notification.id===item.id?{...notification,readAt:new Date().toISOString()}:notification))).catch(()=>notify('Notification status could not be updated.'));}}><Bell size={17}/>{notifications.some(item=>!item.readAt)&&<i/>}</button><button className="topbar-avatar" onClick={()=>setView('profile')} title="Open profile">{initials(user.name)}</button></div>
      </header>
      <div className="content-wrap">
        {view==='dashboard'&&dashboard&&<DashboardView data={dashboard} onNavigate={setView} onRefresh={refresh} busy={busy}/>}
        {view==='competencies'&&<CompetenciesView items={competencies} onSave={async(id,level)=>{await action(()=>patch(`/competencies/${id}`,{selfLevel:level}),'Self assessment saved.');}}/>}
        {view==='learning'&&<LearningView courses={courses} recommendations={dashboard?.recommendations??[]} busy={busy} onEnroll={id=>action(()=>post(`/courses/${id}/enroll`),'Course added to your path.')} onComplete={id=>action(()=>post(`/courses/${id}/complete`),'Learning completion recorded.')} onNavigate={setView}/>}
        {view==='assistant'&&<AssistantView/>}
        {view==='assessment'&&<AssessmentView busy={busy} onNavigate={setView} onFinish={async(attemptId,answers)=>{const result=await action(()=>post<Result>(`/assessment/${attemptId}/submit`,{answers}),'Assessment evaluated.');await loadCore();return result;}} onStart={async()=>{const result=await action(()=>post<{attemptId:string;questions:Question[];total:number}>('/assessment/start'),'Assessment started.');return result;}}/>}
        {view==='profile'&&<ProfileView user={user} onSave={async(values)=>{const updated=await action(()=>patch<User>('/profile',values),'Profile updated.');setUser(updated);}}/>}
        {view==='trainer'&&(user.role==='Trainer'||user.role==='System Admin')&&<TrainerView competencies={competencies} busy={busy} onChange={refresh} notify={notify}/>}
        {view==='admin'&&<AdminView canManage={user.role==='System Admin'}/>}
      </div>
      <footer className="footer"><span>StatLearn · Capacity building for official statistics</span><span>Competency-led learning for official statistics</span></footer>
    </main>
    {toast&&<div className="toast"><CheckCircle2 size={17}/>{toast}</div>}
  </div>;
}

function Login({onLogin,onRegister,busy,toast}:{onLogin:(email:string,password:string)=>Promise<void>;onRegister:(name:string,email:string,password:string)=>Promise<void>;busy:boolean;toast:string}) {
  const [email,setEmail]=useState('');const [password,setPassword]=useState('');const [name,setName]=useState('');const [show,setShow]=useState(false);const [mode,setMode]=useState<'login'|'register'>('login');
  function submit(event:FormEvent){event.preventDefault();if(mode==='register')void onRegister(name,email,password);else void onLogin(email,password);}
  return <div className="login-shell">
    <div className="login-story"><div className="story-grid"/><div className="story-top"><Brand/></div><div className="story-copy"><span className="story-kicker"><span/>CAPACITY BUILDING, REIMAGINED</span><h1>Grow the skills<br/>behind <em>better</em><br/>statistics.</h1><p>A competency-led learning workspace for officials in India's official statistical system.</p><div className="story-flow"><div><Target size={18}/><span>Know your skills</span></div><i/><div><Compass size={18}/><span>Follow your path</span></div><i/><div><TrendingUp size={18}/><span>See your progress</span></div></div></div><div className="story-foot"><span>STATLEARN PLATFORM</span><span>VERSION 0.1</span></div></div>
    <div className="login-panel"><div className="login-panel-top"><span>ACCOUNT ACCESS</span><Badge tone="green">LOCAL ENVIRONMENT</Badge></div><div className="login-form-wrap"><div className="login-symbol"><LockKeyhole size={21}/></div><Kicker>{mode==='login'?'WELCOME BACK':'CREATE A LEARNER ACCOUNT'}</Kicker><h2>{mode==='login'?'Sign in to your workspace':'Create an account'}</h2><p className="login-copy">{mode==='login'?'Sign in with your account, or create a learner profile.':'A learner profile will be created for your organization.'}</p><form onSubmit={submit} className="login-form">{mode==='register'&&<label>Full name<input autoComplete="name" value={name} onChange={e=>setName(e.target.value)} required minLength={2} maxLength={100}/></label>}<label>Email address<input type="email" autoComplete="username" value={email} onChange={e=>setEmail(e.target.value)} required/></label><label>Password<div className="password-wrap"><input type={show?'text':'password'} autoComplete={mode==='login'?'current-password':'new-password'} minLength={mode==='register'?10:1} value={password} onChange={e=>setPassword(e.target.value)} required/><button type="button" onClick={()=>setShow(!show)}>{show?'Hide':'Show'}</button></div></label><button className="primary-btn full-btn" type="submit" disabled={busy}>{busy?<LoaderCircle className="spin" size={16}/>:null}{mode==='login'?'Continue to workspace':'Create account'}<ArrowRight size={16}/></button></form>
      {mode==='login'?<><button className="auth-mode-btn" onClick={()=>{setMode('register');setEmail('');setPassword('');}}>New to StatLearn? <strong>Create a learner account</strong></button></>:<button className="auth-mode-btn" onClick={()=>{setMode('login');setEmail('');setPassword('');}}>Already have an account? <strong>Sign in</strong></button>}
      {toast&&<div className="login-error">{toast}</div>}<p className="privacy-note"><ShieldCheck size={14}/>Only enter data your organization is authorized to process here.</p></div><div className="login-panel-foot">© 2026 StatLearn <span>Help & support</span></div></div>
  </div>;
}

function DashboardView({data,onNavigate,onRefresh,busy}:{data:Dashboard;onNavigate:(view:View)=>void;onRefresh:()=>void;busy:boolean}) {
  const first=data.user.name.split(' ')[0];
  const topCompetencies=data.competencies.filter(c=>c.requiredLevel!==null).slice(0,7);
  return <>
    <PageHeading eyebrow="YOUR LEARNING OVERVIEW" title={`${greeting()}, ${first}`} description="A clear view of your skills, priorities, and next steps." actions={<button className="quiet-btn" onClick={onRefresh} disabled={busy}><RefreshCw size={15} className={busy?'spin':''}/>Refresh</button>}/>
    <div className="welcome-banner"><div className="welcome-copy"><div className="welcome-top"><span className="welcome-icon"><Sparkles size={15}/></span><span>YOUR SKILLS JOURNEY</span></div><h2>Build confidence in the work<br/>that makes a difference.</h2><p>Your profile is mapped to <strong>{data.user.jobRole}</strong>. We’ve highlighted the skills with the biggest opportunity to grow.</p><button className="light-btn" onClick={()=>onNavigate('competencies')}>Explore my competencies<ArrowRight size={15}/></button></div><div className="banner-art"><div className="art-orbit orbit-one"/><div className="art-orbit orbit-two"/><div className="art-core"><Target size={29}/></div><div className="orbit-node node-one"><BookOpen size={14}/></div><div className="orbit-node node-two"><TrendingUp size={14}/></div><div className="orbit-node node-three"><Sparkles size={14}/></div><div className="art-label">LEARN · APPLY · GROW</div></div></div>
    <div className="metric-grid">
      <Metric icon={Activity} label="Role readiness" value={`${data.readiness}%`} note="Against your role framework" tone="teal" trend={`${data.competencies.filter(c=>c.gap===0).length} skills at target`}/>
      <Metric icon={Target} label="Skills to strengthen" value={String(data.gapCount)} note="Mapped to your current role" tone="amber" trend={`${data.criticalCount} critical priority`}/>
      <Metric icon={Clock3} label="Learning hours" value={`${data.learningHours}h`} note="Recorded course completions" tone="blue" trend={`${data.completedCount} completed`}/>
      <Metric icon={Award} label="Latest assessment" value={data.latestAssessment?`${Math.round(data.latestAssessment.score)}%`:'—'} note={data.latestAssessment?`${data.latestAssessment.total} questions evaluated`:'Take your first skills check'} tone="purple" trend={data.latestAssessment?'Score recorded':'Ready when you are'}/>
    </div>
    <div className="dashboard-grid">
      <section className="panel competency-panel"><div className="panel-head"><div><Kicker>COMPETENCY PROFILE</Kicker><h3>Where you are today</h3><p>Current level compared with your role requirement</p></div><button className="text-btn" onClick={()=>onNavigate('competencies')}>View all<ArrowRight size={14}/></button></div><div className="competency-list">{topCompetencies.map(item=><div className="competency-row" key={item.id}><div className="comp-name"><span className={`comp-dot ${item.category==='Technical'?'dot-blue':item.category==='Statistical'?'dot-teal':item.category==='Digital governance'?'dot-purple':'dot-amber'}`}/><strong>{item.name}</strong></div><div className="comp-levels"><span>{item.currentLevel}<small> / {item.requiredLevel}</small></span><div className="level-track"><span style={{width:`${item.currentLevel/5*100}%`}}/><i style={{left:`${(item.requiredLevel??0)/5*100}%`}}/></div><Badge tone={item.gap===0?'green':item.gap>=3?'red':item.gap===2?'amber':'blue'}>{item.gap===0?'On track':`${item.gap} level${item.gap>1?'s':''} gap`}</Badge></div></div>)}</div><div className="panel-legend"><span><i className="legend-fill"/>Your current level</span><span><i className="legend-target"/>Role requirement</span><small>Levels 0–5</small></div></section>
      <section className="panel priority-panel"><div className="panel-head"><div><Kicker>FOCUS AREAS</Kicker><h3>Priority skills</h3><p>Start with the most relevant gaps</p></div><span className="number-pill">{data.priorityGaps.length}</span></div>{data.priorityGaps.length?data.priorityGaps.slice(0,4).map((item,index)=><button className="priority-item" key={item.id} onClick={()=>onNavigate('competencies')}><div className={`priority-index priority-${item.gap>=3?'high':item.gap===2?'mid':'low'}`}>{String(index+1).padStart(2,'0')}</div><div className="priority-copy"><strong>{item.name}</strong><span>Current {item.currentLevel} · Required {item.requiredLevel}</span></div><span className="priority-gap">+{item.gap}</span><ChevronRight size={15}/></button>):<Empty icon={CheckCircle2} title="You're at role level" description="Your current skills meet the requirements in this role framework."/>}<button className="outline-btn full-btn" onClick={()=>onNavigate('assessment')}><CheckCircle2 size={15}/>Take a competency check<ArrowRight size={15}/></button></section>
    </div>
    <div className="dashboard-bottom">
      <section className="panel rec-panel"><div className="panel-head"><div><Kicker>PERSONALISED FOR YOU</Kicker><h3>Recommended next steps</h3><p>Courses ranked by your role, skill gaps, and learning history</p></div><button className="text-btn" onClick={()=>onNavigate('learning')}>Learning library<ArrowRight size={14}/></button></div>{data.recommendations.length?data.recommendations.slice(0,3).map((course,index)=><div className="recommend-row" key={course.id}><div className={`course-art course-art-${index+1}`}><BookOpen size={19}/><span>{String(index+1).padStart(2,'0')}</span></div><div className="recommend-copy"><div><strong>{course.title}</strong><Badge tone={course.providerType.includes('mock')?'amber':'blue'}>{course.providerType.includes('mock')?'MOCK PROVIDER':'INTERNAL'}</Badge></div><p>{course.explanation}</p><div className="course-meta"><span><Clock3 size={13}/>{course.hours} hrs</span><span>{course.difficulty}</span><span>{competencyNames(course).slice(0,2).join(' · ')}</span></div></div><button className="round-arrow" onClick={()=>onNavigate('learning')} aria-label={`View ${course.title}`}><ArrowUpRight size={16}/></button></div>):<Empty icon={CheckCircle2} title="No recommendations yet" description="Complete a competency check to create a personalised path."/>}</section>
      <section className="panel progress-panel"><div className="panel-head"><div><Kicker>LEARNING MOMENTUM</Kicker><h3>Your progress</h3><p>Progress recorded in your learning library</p></div><div className="progress-ring" style={{'--ring':`${data.enrolledCount?Math.round(data.completedCount/data.enrolledCount*100):0}%`} as CSSProperties}><div><strong>{data.enrolledCount?Math.round(data.completedCount/data.enrolledCount*100):0}<small>%</small></strong><span>complete</span></div></div></div><div className="momentum-stat"><div><span>Courses in progress</span><strong>{Math.max(0,data.enrolledCount-data.completedCount)}</strong></div><div><span>Courses completed</span><strong>{data.completedCount}</strong></div></div><button className="text-btn" onClick={()=>onNavigate('learning')}>Continue learning<ArrowRight size={14}/></button></section>
    </div>
    <div className="bottom-strip"><div className="strip-icon"><Sparkles size={18}/></div><div><strong>Need a quick answer?</strong><span>Ask your learning assistant about a competency, concept, or source.</span></div><button className="text-btn" onClick={()=>onNavigate('assistant')}>Ask a question<ArrowRight size={14}/></button></div>
  </>;
}

function Metric({icon:Icon,label,value,note,tone,trend}:{icon:typeof Activity;label:string;value:string;note:string;tone:string;trend:string}) {
  return <div className="metric-card"><div className={`metric-icon metric-${tone}`}><Icon size={18}/></div><div className="metric-copy"><span>{label}</span><strong>{value}</strong><small>{note}</small></div><div className="metric-footer"><span className={`metric-trend trend-${tone}`}>{tone==='amber'?<ArrowDownRight size={13}/>:<ArrowUpRight size={13}/>} {trend}</span><span className="metric-period">YOUR DATA</span></div></div>;
}

function CompetenciesView({items,onSave}:{items:Competency[];onSave:(id:number,level:number)=>Promise<void>}) {
  const [filter,setFilter]=useState('All competencies');const [query,setQuery]=useState('');const [saving,setSaving]=useState<number|null>(null);
  const categories=useMemo(()=>['All competencies',...new Set(items.map(c=>c.category))],[items]);
  const visible=items.filter(item=>(filter==='All competencies'||item.category===filter)&&item.name.toLowerCase().includes(query.toLowerCase()));
  const groups=[...new Set(visible.map(c=>c.category))];
  async function save(id:number,value:number){setSaving(id);try{await onSave(id,value);}finally{setSaving(null);}}
