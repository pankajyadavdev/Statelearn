function TrainerView({competencies,busy,onChange,notify}:{competencies:Competency[];busy:boolean;onChange:()=>void;notify:(message:string)=>void}) {
  const [dashboard,setDashboard]=useState<any>(null);
  const [resources,setResources]=useState<any[]>([]);
  const [form,setForm]=useState({competencyId:String(competencies[0]?.id??''),question:'',option1:'',option2:'',option3:'',correctIndex:'0',explanation:''});
  const [saving,setSaving]=useState(false),[uploading,setUploading]=useState(false),[generating,setGenerating]=useState(false);
  const [file,setFile]=useState<File|null>(null),[language,setLanguage]=useState('English');
  const load=useCallback(async()=>{try{const [queue,library]=await Promise.all([api<any>('/trainer/dashboard'),api<any>('/resources')]);setDashboard(queue);setResources(library.items);}catch(error){notify(error instanceof Error?error.message:'Trainer data could not be loaded.');}},[notify]);
  useEffect(()=>{void load();},[load]);
  async function createDraft(event:FormEvent){event.preventDefault();setSaving(true);try{await post('/trainer/questions',{competencyId:Number(form.competencyId),question:form.question,options:[form.option1,form.option2,...(form.option3?[form.option3]:[])],correctIndex:Number(form.correctIndex),explanation:form.explanation});setForm({...form,question:'',option1:'',option2:'',option3:'',explanation:''});notify('Question saved as a draft for review.');await load();onChange();}catch(error){notify(error instanceof Error?error.message:'Question could not be saved.');}finally{setSaving(false);}}
  async function generateDraft(){setGenerating(true);try{const result=await post<{source:string}>('/trainer/questions/generate',{competencyId:Number(form.competencyId)});notify(`Draft created from ${result.source}. Trainer review is required.`);await load();}catch(error){notify(error instanceof Error?error.message:'A source-based question could not be drafted.');}finally{setGenerating(false);}}
  async function upload(event:FormEvent){event.preventDefault();if(!file){notify('Choose a learning file first.');return;}setUploading(true);try{const result=await uploadDocument<{chunkCount:number}>(file,Number(form.competencyId),language);notify(`Learning source added as ${result.chunkCount} searchable chunks.`);setFile(null);const input=document.getElementById('learning-upload') as HTMLInputElement|null;if(input)input.value='';await load();}catch(error){notify(error instanceof Error?error.message:'The document could not be added.');}finally{setUploading(false);}}
  async function review(id:number,status:'published'|'rejected'){try{await patch(`/trainer/questions/${id}/review`,{status});notify(status==='published'?'Question approved and published.':'Question rejected.');await load();}catch(error){notify(error instanceof Error?error.message:'Review could not be saved.');}}
  const competencySelect=()=> <select value={form.competencyId} onChange={e=>setForm({...form,competencyId:e.target.value})}>{competencies.map(c=><option key={c.id} value={c.id}>{c.name}</option>)}</select>;
  return <>
    <PageHeading eyebrow="TRAINER WORKSPACE" title="Trainer studio" description="Add learning sources, prepare reviewed assessments, and follow learner activity." actions={<Badge tone="purple"><GraduationCap size={13}/>Trainer access</Badge>}/>
    <div className="trainer-metrics"><div><span>Draft questions</span><strong>{dashboard?.draftQuestions??'—'}</strong><small>Awaiting trainer review</small></div><div><span>Registered learners</span><strong>{dashboard?.learners??'—'}</strong><small>Current learner accounts</small></div><div><span>Submitted checks</span><strong>{dashboard?.assessments??'—'}</strong><small>Across registered learners</small></div></div>
    <section className="panel trainer-upload-panel"><div className="panel-head"><div><Kicker>LEARNING MATERIAL INGESTION</Kicker><h3>Add a source to the assistant</h3><p>Text is extracted, split into searchable chunks, and stored in PostgreSQL.</p></div><Badge tone="blue">PDF · DOCX · PPTX · TXT</Badge></div>
      <form className="upload-row" onSubmit={upload}><label className="upload-file"><input id="learning-upload" type="file" accept=".pdf,.docx,.pptx,.txt,.md" onChange={event=>setFile(event.target.files?.[0]??null)}/><span><Plus size={15}/>{file?.name??'Choose a document'}</span><small>Max file size 10 MB</small></label><label>Competency{competencySelect()}</label><label>Language<select value={language} onChange={e=>setLanguage(e.target.value)}><option>English</option><option>Hindi</option><option>English and Hindi</option></select></label><button className="primary-btn" disabled={uploading||!file}>{uploading?<LoaderCircle size={15} className="spin"/>:<Plus size={15}/>}Ingest source</button></form>
      <div className="uploaded-list">{resources.filter(resource=>!resource.isSynthetic).map(resource=><div key={resource.id}><FileText size={14}/><span><strong>{resource.fileName}</strong><small>{resource.competency} · {resource.chunkCount} chunks</small></span><Badge tone="green">READY</Badge></div>)}</div>
    </section>
    <div className="trainer-grid"><section className="panel trainer-form-panel"><div className="panel-head"><div><Kicker>QUESTION REVIEW WORKFLOW</Kicker><h3>Draft a learning question</h3><p>Generated drafts remain unpublished until a trainer approves them.</p></div><button className="outline-btn generate-btn" disabled={generating||busy} onClick={()=>void generateDraft()}>{generating?<LoaderCircle size={14} className="spin"/>:<Sparkles size={14}/>}Source-based draft</button></div>
      <form className="question-form" onSubmit={createDraft}><label>Competency{competencySelect()}</label><label>Question<input value={form.question} onChange={e=>setForm({...form,question:e.target.value})} required minLength={12} maxLength={600} placeholder="Write a clear, single-concept question"/></label><div className="question-options"><label>Option A<input value={form.option1} onChange={e=>setForm({...form,option1:e.target.value})} required/></label><label>Option B<input value={form.option2} onChange={e=>setForm({...form,option2:e.target.value})} required/></label><label>Option C (optional)<input value={form.option3} onChange={e=>setForm({...form,option3:e.target.value})}/></label><label>Correct answer<select value={form.correctIndex} onChange={e=>setForm({...form,correctIndex:e.target.value})}><option value="0">Option A</option><option value="1">Option B</option>{form.option3&&<option value="2">Option C</option>}</select></label></div><label>Explanation<input value={form.explanation} onChange={e=>setForm({...form,explanation:e.target.value})} required minLength={8} placeholder="Explain the reasoning behind the answer"/></label><button className="primary-btn" disabled={saving||busy}>{saving?<LoaderCircle size={15} className="spin"/>:<Plus size={15}/>}Save question for review</button></form>
    </section><section className="panel trainer-review-panel"><div className="panel-head"><div><Kicker>CONTENT QUEUE</Kicker><h3>Review questions</h3></div><button className="icon-btn" onClick={()=>void load()} aria-label="Refresh queue"><RefreshCw size={15}/></button></div><div className="question-queue">{dashboard?.questions?.length?dashboard.questions.map((question:any)=><div className="queue-item" key={question.id}><div className="queue-item-main"><Badge tone={question.status==='published'?'green':question.status==='rejected'?'red':'amber'}>{question.status}</Badge><strong>{question.question}</strong><span>{question.competency}</span></div>{question.status==='draft'&&<div className="queue-actions"><button onClick={()=>void review(question.id,'published')} title="Approve"><Check size={14}/></button><button onClick={()=>void review(question.id,'rejected')} title="Reject">×</button></div>}</div>):<Empty icon={FileText} title="No question drafts" description="Draft questions added in this workspace will appear here for review."/>}</div></section></div>
    <div className="provider-note"><ShieldCheck size={16}/><span>Generated questions stay in draft status until trainer approval. Legacy .ppt files must be converted to .pptx.</span></div>
  </>;
}

function AdminView({canManage}:{canManage:boolean}) {
  const [data,setData]=useState<any>(null);const [error,setError]=useState('');const [loading,setLoading]=useState(true);
  const load=useCallback(()=>{setLoading(true);api<any>('/admin/analytics').then(setData).catch(error=>setError(error.message)).finally(()=>setLoading(false));},[]);
  useEffect(()=>{void load();},[load]);
  if(loading)return <div className="admin-loading"><LoaderCircle className="spin"/>Loading department insights…</div>;
  if(error)return <div><PageHeading eyebrow="DEPARTMENT INSIGHTS" title="Analytics" description="Current learning activity and competency gaps."/><div className="panel"><Empty icon={ShieldCheck} title="Access required" description={error}/></div></div>;
  const completionTotal=data.courseEffectiveness.reduce((sum:number,row:any)=>sum+row.enrollments,0);const completions=data.courseEffectiveness.reduce((sum:number,row:any)=>sum+row.completions,0);
  return <><PageHeading eyebrow="DEPARTMENT INSIGHTS" title="Analytics" description="A database-backed view of learning participation and competency gaps." actions={<Badge tone="amber">LIVE DATA</Badge>}/><div className="analytics-banner"><div><BarChart3 size={20}/><span><strong>Learning analytics</strong><small>Summary of current learner activity and competency gaps.</small></span></div><button className="quiet-btn" onClick={load}><RefreshCw size={14}/>Refresh</button></div><div className="admin-metric-grid"><AdminMetric label="Registered users" value={data.officials} note="Current user accounts" icon={Users}/><AdminMetric label="Active learners" value={data.activeLearners} note="With a course in progress" icon={Activity}/><AdminMetric label="Average assessment" value={`${Math.round(data.averageAssessment)}%`} note="Submitted assessments" icon={CheckCircle2}/><AdminMetric label="Course completion" value={`${completionTotal?Math.round(completions/completionTotal*100):0}%`} note={`${completions} completions across ${completionTotal} enrollments`} icon={TrendingUp}/></div><PredictionPanel/><div className="analytics-grid"><section className="panel analytics-panel"><div className="panel-head"><div><Kicker>SKILL NEEDS</Kicker><h3>Top competency gaps</h3><p>Aggregated gap levels in registered learner records</p></div><Target size={17}/></div><div className="bar-chart">{data.topGaps.map((row:any,index:number)=><div className="bar-row" key={row.competency}><span>{row.competency}</span><div><i style={{width:`${Math.min(100,row.gapPoints*6)}%`}}/></div><strong>{row.gapPoints}</strong></div>)}</div></section><section className="panel analytics-panel"><div className="panel-head"><div><Kicker>DEPARTMENT SNAPSHOT</Kicker><h3>Participation</h3><p>Learner activity by department</p></div><Users size={17}/></div>{data.departments.map((row:any)=><div className="department-row" key={row.department}><div className="department-avatar">{initials(row.department)}</div><div><strong>{row.department}</strong><small>{row.learnersCompleted} completed learners</small></div><Badge tone="blue">{row.officials} officials</Badge></div>)}</section></div><section className="panel effectiveness-panel"><div className="panel-head"><div><Kicker>LEARNING EFFECTIVENESS</Kicker><h3>Course activity</h3><p>Completion counts drawn from course progress rows</p></div></div><div className="effectiveness-table"><div className="table-head"><span>COURSE</span><span>ENROLMENTS</span><span>COMPLETED</span><span>COMPLETION</span></div>{data.courseEffectiveness.map((row:any)=><div className="effectiveness-row" key={row.course}><strong>{row.course}</strong><span>{row.enrollments}</span><span>{row.completions}</span><div><Progress value={row.completionRate}/><small>{row.completionRate}%</small></div></div>)}</div></section><div className="provider-note"><ShieldCheck size={16}/><span>Analytics are calculated from current learner and course activity.</span></div>{canManage&&<FrameworkManager/>}</>;
}

function PredictionPanel(){
  const [report,setReport]=useState<PredictionReport|null>(null);const [error,setError]=useState('');
  useEffect(()=>{api<PredictionReport>('/admin/predictions').then(setReport).catch(problem=>setError(problem instanceof Error?problem.message:'Scenario could not be loaded.'));},[]);
  return <section className="panel prediction-panel"><div className="panel-head"><div><Kicker>TRAINING DEMAND</Kicker><h3>Training-demand scenario</h3><p>{report?`${report.population} learners in the current role-gap snapshot`:error||'Calculating current competency gaps…'}</p></div><Badge tone="amber">NOT A FORECAST</Badge></div><p className="prediction-method">{report?.method??error}</p>{report?.items.map(item=><div className="prediction-row" key={item.competency}><div><strong>{item.competency}</strong><small>{item.learnersBelow} of {item.evaluatedLearners} below target · {item.mappedCourses} mapped courses</small></div><Progress value={item.demandScore} tone="amber"/><Badge tone={item.priority==='Critical'||item.priority==='High'?'amber':'blue'}>{item.demandScore} score</Badge></div>)}</section>;
}

function FrameworkManager() {
  const [framework,setFramework]=useState<Framework|null>(null);const [error,setError]=useState('');const [busy,setBusy]=useState(false);const [notice,setNotice]=useState('');
  const [competency,setCompetency]=useState({name:'',category:'Statistical',description:''});
  const [role,setRole]=useState({name:'',description:''});
  const [account,setAccount]=useState({name:'',email:'',password:'',role:'Trainer'});
  const [course,setCourse]=useState({title:'',description:'',provider:'',providerType:'Internal',durationHours:'2',difficulty:'Beginner',language:'English',competencyId:'',targetLevel:'1'});
  const [mapping,setMapping]=useState({roleId:'',competencyId:'',learnerId:'',requiredLevel:'3',priority:'Medium'});
  const load=useCallback(async()=>{try{const result=await api<Framework>('/admin/framework');setFramework(result);setError('');setMapping(current=>({...current,roleId:current.roleId||String(result.roles[0]?.id??''),competencyId:current.competencyId||String(result.competencies[0]?.id??''),learnerId:current.learnerId||String(result.learners[0]?.id??'')}));setCourse(current=>({...current,competencyId:current.competencyId||String(result.competencies.find(item=>item.active)?.id??'')}));}catch(problem){setError(problem instanceof Error?problem.message:'Framework could not be loaded.');}},[]);
  useEffect(()=>{void load();},[load]);
  async function submit(event:FormEvent,kind:'competency'|'role'|'mapping'|'assignment'|'account'|'course'){event.preventDefault();setBusy(true);setNotice('');try{
    if(kind==='competency'){await post('/admin/competencies',competency);setCompetency({name:'',category:framework?.categories[0]?.name??'Statistical',description:''});setNotice('Competency added to the framework.');}
    if(kind==='role'){const result=await post<{id:number}>('/admin/job-roles',role);setRole({name:'',description:''});setMapping(current=>({...current,roleId:String(result.id)}));setNotice('Job role created. Add its required competencies below.');}
    if(kind==='mapping'){await post(`/admin/job-roles/${mapping.roleId}/competencies`,{competencyId:Number(mapping.competencyId),requiredLevel:Number(mapping.requiredLevel),priority:mapping.priority});setNotice('Role requirement saved.');}
    if(kind==='assignment'){await patch(`/admin/users/${mapping.learnerId}/job-role`,{jobRoleId:Number(mapping.roleId)});setNotice('Learner role changed; skill gaps and recommendations were recalculated.');}
    if(kind==='account'){await post('/admin/users',account);setAccount({name:'',email:'',password:'',role:'Trainer'});setNotice(`${account.role} account created.`);}
    if(kind==='course'){await post('/admin/courses',{...course,durationHours:Number(course.durationHours),competencies:[{competencyId:Number(course.competencyId),targetLevel:Number(course.targetLevel)}]});setCourse(current=>({...current,title:'',description:'',provider:'',competencyId:current.competencyId}));setNotice('Course added to the learning catalogue.');}
    await load();
  }catch(problem){setNotice(problem instanceof Error?problem.message:'The framework change could not be saved.');}finally{setBusy(false);}}
  return <section className="panel framework-manager"><div className="panel-head"><div><Kicker>FRAMEWORK ADMINISTRATION</Kicker><h3>Competencies and job-role requirements</h3><p>Changes apply to the current competency framework.</p></div><button className="icon-btn" onClick={()=>void load()} aria-label="Refresh competency framework"><RefreshCw size={15}/></button></div>
    {error&&<div className="form-error" role="alert">{error}</div>}{notice&&<div className="form-note" role="status">{notice}</div>}
    {framework&&<><div className="framework-admin-grid">
      <form className="question-form framework-form" onSubmit={event=>void submit(event,'competency')}><h4>Add a competency</h4><label>Name<input value={competency.name} onChange={event=>setCompetency({...competency,name:event.target.value})} required minLength={2} maxLength={100}/></label><label>Category<input list="framework-category-list" value={competency.category} onChange={event=>setCompetency({...competency,category:event.target.value})} required minLength={2} maxLength={80}/><datalist id="framework-category-list">{framework.categories.map(item=><option key={item.id} value={item.name}/>)}</datalist></label><label>Description<textarea value={competency.description} onChange={event=>setCompetency({...competency,description:event.target.value})} required minLength={8} maxLength={1000}/></label><button className="primary-btn" disabled={busy}>Add competency</button></form>
      <form className="question-form framework-form" onSubmit={event=>void submit(event,'role')}><h4>Add a job role</h4><label>Role name<input value={role.name} onChange={event=>setRole({...role,name:event.target.value})} required minLength={2} maxLength={120}/></label><label>Description<textarea value={role.description} onChange={event=>setRole({...role,description:event.target.value})} required minLength={8} maxLength={1000}/></label><button className="primary-btn" disabled={busy}>Create role</button></form>
      <form className="question-form framework-form" onSubmit={event=>void submit(event,'account')}><h4>Create a platform account</h4><label>Full name<input value={account.name} onChange={event=>setAccount({...account,name:event.target.value})} required minLength={2} maxLength={100}/></label><label>Email<input type="email" value={account.email} onChange={event=>setAccount({...account,email:event.target.value})} required maxLength={254}/></label><label>Temporary password<input type="password" value={account.password} onChange={event=>setAccount({...account,password:event.target.value})} required minLength={10} maxLength={128}/></label><label>Account role<select value={account.role} onChange={event=>setAccount({...account,role:event.target.value})}><option>Learner</option><option>Trainer</option><option>Department Admin</option></select></label><button className="primary-btn" disabled={busy}>Create account</button></form>
      <form className="question-form framework-form" onSubmit={event=>void submit(event,'course')}><h4>Add a learning course</h4><label>Course title<input value={course.title} onChange={event=>setCourse({...course,title:event.target.value})} required minLength={3} maxLength={200}/></label><label>Description<textarea value={course.description} onChange={event=>setCourse({...course,description:event.target.value})} required minLength={8} maxLength={3000}/></label><div className="question-options"><label>Provider<input value={course.provider} onChange={event=>setCourse({...course,provider:event.target.value})} required/></label><label>Duration (hours)<input type="number" min="0.1" max="1000" step="0.1" value={course.durationHours} onChange={event=>setCourse({...course,durationHours:event.target.value})} required/></label></div><div className="question-options"><label>Competency<select value={course.competencyId} onChange={event=>setCourse({...course,competencyId:event.target.value})} required>{framework.competencies.filter(item=>item.active).map(item=><option key={item.id} value={item.id}>{item.name}</option>)}</select></label><label>Target level<select value={course.targetLevel} onChange={event=>setCourse({...course,targetLevel:event.target.value})}>{framework.levels.map(item=><option key={item.level} value={item.level}>{item.level} · {item.label}</option>)}</select></label></div><div className="question-options"><label>Difficulty<select value={course.difficulty} onChange={event=>setCourse({...course,difficulty:event.target.value})}><option>Beginner</option><option>Intermediate</option><option>Advanced</option></select></label><label>Language<input value={course.language} onChange={event=>setCourse({...course,language:event.target.value})} required maxLength={60}/></label></div><button className="primary-btn" disabled={busy||!course.competencyId}>Add course</button></form>
      <form className="question-form framework-form" onSubmit={event=>void submit(event,'mapping')}><h4>Map a required competency</h4><label>Job role<select value={mapping.roleId} onChange={event=>setMapping({...mapping,roleId:event.target.value})}>{framework.roles.map(item=><option key={item.id} value={item.id}>{item.name}</option>)}</select></label><label>Competency<select value={mapping.competencyId} onChange={event=>setMapping({...mapping,competencyId:event.target.value})}>{framework.competencies.filter(item=>item.active).map(item=><option key={item.id} value={item.id}>{item.name}</option>)}</select></label><div className="question-options"><label>Required level<select value={mapping.requiredLevel} onChange={event=>setMapping({...mapping,requiredLevel:event.target.value})}>{framework.levels.map(item=><option key={item.level} value={item.level}>{item.level} · {item.label}</option>)}</select></label><label>Priority<select value={mapping.priority} onChange={event=>setMapping({...mapping,priority:event.target.value})}><option>Low</option><option>Medium</option><option>High</option><option>Critical</option></select></label></div><button className="primary-btn" disabled={busy||!mapping.roleId||!mapping.competencyId}>Save requirement</button></form>
      <form className="question-form framework-form" onSubmit={event=>void submit(event,'assignment')}><h4>Assign a learner job role</h4><label>Learner<select value={mapping.learnerId} onChange={event=>setMapping({...mapping,learnerId:event.target.value})}>{framework.learners.map(item=><option key={item.id} value={item.id}>{item.name} · {item.email}</option>)}</select></label><label>Job role<select value={mapping.roleId} onChange={event=>setMapping({...mapping,roleId:event.target.value})}>{framework.roles.map(item=><option key={item.id} value={item.id}>{item.name}</option>)}</select></label><small>Changing a role immediately recalculates the learner’s skill gaps and recommendations.</small><button className="primary-btn" disabled={busy||!mapping.learnerId||!mapping.roleId}>Assign job role</button></form>
    </div><div className="framework-summary"><div><strong>{framework.competencies.length}</strong><span>competencies</span></div><div><strong>{framework.roles.length}</strong><span>job roles</span></div><div><strong>{framework.mappings.length}</strong><span>role requirements</span></div></div><div className="framework-mappings"><h4>Current role requirements</h4>{framework.mappings.map(item=><div key={`${item.jobRoleId}-${item.competencyId}`}><span><strong>{item.roleName}</strong><small>{item.competencyName}</small></span><Badge tone={item.priority==='Critical'||item.priority==='High'?'amber':'blue'}>Level {item.requiredLevel} · {item.priority}</Badge></div>)}</div></>}
  </section>;
}
function AdminMetric({label,value,note,icon:Icon}:{label:string;value:string|number;note:string;icon:typeof Users}){return <div className="admin-metric"><div className="admin-metric-icon"><Icon size={17}/></div><div><span>{label}</span><strong>{value}</strong><small>{note}</small></div></div>;}
