ult.recommendations.length&&<Empty title="You’re at role level" description="There are no open competency gaps."/>}</section></div><section className="panel feedback-panel"><div className="panel-head"><div><Kicker>QUESTION REVIEW</Kicker><h3>Feedback and explanations</h3></div></div><div className="feedback-list">{result.feedback.map((item,index)=><article key={item.questionId} className="feedback-item"><div className={`feedback-result ${item.isCorrect?'correct':'incorrect'}`}>{item.isCorrect?<Check size={15}/>:<span>×</span>}</div><div><div className="feedback-question-head"><Badge tone="blue">{item.competency}</Badge><span>QUESTION {index+1}</span></div><strong>{item.question}</strong><p>{item.explanation}</p>{item.source&&<small><FileText size={12}/>{item.source.title} · p. {item.source.page}</small>}</div></article>)}</div></section></>;
